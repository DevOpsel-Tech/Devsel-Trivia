# Copy to .env on the NAS; never commit real credentials.
# Prefer a shared commit SHA for both images in production.
APP_VERSION=latest

# Match the existing volume's PostgreSQL major version and mount path.
# Example for an empty volume using PostgreSQL 16:
POSTGRES_VERSION=16
POSTGRES_MOUNT_PATH=/var/lib/postgresql/data
POSTGRES_VOLUME=postgreSQl-trivia
POSTGRES_DB=trivia_db
POSTGRES_USER=trivia_user

# Generate two distinct secrets: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a URL-safe hexadecimal database password because Compose constructs DATABASE_URL.
# For an existing database, retain its credentials and URL-encode them if necessary by adapting DATABASE_URL separately.
POSTGRES_PASSWORD=
JWT_SECRET=

FRONTEND_ORIGIN=https://trivia.devopsel.com
