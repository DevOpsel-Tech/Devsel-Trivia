# Copia este archivo a .env. No subas .env a Git.
PORT=3000

# Configura la URL de tu base de datos de prácticas.
DATABASE_URL=

# Genera un secreto con este comando:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos por CORS, separados por comas y sin rutas.
# Añade aquí el origen actual del Dev Tunnel cuando lo uses.
FRONTEND_ORIGIN=http://localhost:5173,https://tu-tunel-5173.uks1.devtunnels.ms
